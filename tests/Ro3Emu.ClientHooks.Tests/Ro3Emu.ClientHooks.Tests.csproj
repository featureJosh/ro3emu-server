    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Compiles ClientHooks sources, which keep warnings as warnings (see Ro3Emu.ClientHooks.csproj). -->
