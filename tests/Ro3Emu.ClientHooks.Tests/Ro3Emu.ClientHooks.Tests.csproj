    <Compile Include="../../src/Ro3Emu.ClientHooks/CooldownMirror.cs" Link="CooldownMirror.cs" />
    <Compile Include="../../src/Ro3Emu.ClientHooks/ControllerIni.cs" Link="ControllerIni.cs" />
    <Compile Include="../../src/Ro3Emu.ClientHooks/MenuInputLogic.cs" Link="MenuInputLogic.cs" />
    <Compile Include="../../src/Ro3Emu.ClientHooks/TargetMath.cs" Link="TargetMath.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
